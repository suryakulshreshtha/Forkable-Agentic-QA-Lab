# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- Sample LLM app / LLM-evaluation suite ---
LLM_API_KEY=                 # key for whichever LLM provider sample_llm_app wraps
LLM_API_BASE_URL=            # e.g. https://api.openai.com/v1 or a self-hosted endpoint

# --- Groq (used by the n8n bug-reporting agent) ---
GROQ_API_KEY=                # from https://console.groq.com/keys

# --- n8n (bug-reporting agent) ---
N8N_WEBHOOK_URL=              # the workflow's webhook trigger URL
JIRA_API_TOKEN=
JIRA_BASE_URL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GOOGLE_SHEETS_ID=

# --- Power Platform (Power Apps Test Engine) ---
POWERPLATFORM_TENANT_ID=
POWERPLATFORM_CLIENT_ID=
POWERPLATFORM_ENVIRONMENT_URL=

# --- GitHub (used only by scripts/set_repo_metadata.sh) ---
# Not needed for local test runs — only for the repo-metadata script, and only
# if you haven't already authenticated the gh CLI (`gh auth login`).
GITHUB_TOKEN=
